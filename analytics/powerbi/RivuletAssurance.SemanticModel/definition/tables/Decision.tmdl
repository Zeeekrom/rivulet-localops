table Decision
	lineageTag: 5d38417e-39f6-59e0-9d5d-d7949d73d727

	measure 'Decision Count' = COUNTROWS(Decision)
		formatString: #,0
		lineageTag: f2ac77b8-0ce4-53a8-a8fe-15d40114f1f3

	measure 'Pass Decisions' = CALCULATE([Decision Count], Decision[gate_status] = "pass")
		formatString: #,0
		lineageTag: 784361aa-393d-5881-8b09-80ed5263e9ce

	measure 'Pass Rate' = DIVIDE([Pass Decisions], [Decision Count])
		formatString: 0.0%
		lineageTag: 801b77f0-3feb-52b6-aa8d-0daad363bbd2

	measure 'Reject Decisions' = CALCULATE([Decision Count], Decision[gate_status] = "reject")
		formatString: #,0
		lineageTag: 67bf27c5-73a6-54d8-9019-c95e1e8bf7c3

	measure 'Reject Rate' = DIVIDE([Reject Decisions], [Decision Count])
		formatString: 0.0%
		lineageTag: 99ebbe0e-bfb4-57d4-b591-80d525f1fc01

	measure 'Escalate Decisions' = CALCULATE([Decision Count], Decision[gate_status] = "escalate")
		formatString: #,0
		lineageTag: 5292f78a-3b10-5d3b-94d5-fde1c8201c2b

	measure 'Escalate Rate' = DIVIDE([Escalate Decisions], [Decision Count])
		formatString: 0.0%
		lineageTag: 722bb6eb-2b8e-571a-8a21-c088d507723f

	measure 'Reviewed Decisions' = CALCULATE([Decision Count], Decision[review_state] = "reviewed")
		formatString: #,0
		lineageTag: 65b5a1c2-e176-56e2-9418-fbb6cba36195

	measure 'Review Rate' = DIVIDE([Reviewed Decisions], [Decision Count])
		formatString: 0.0%
		lineageTag: 69e2cf47-cb14-5283-a232-f7a6411bae99

	measure 'Override Decisions' = CALCULATE([Decision Count], Decision[current_review_action] = "override")
		formatString: #,0
		lineageTag: 099aa5d8-e50b-50f4-be6c-2cd9f7005fb7

	measure 'Override Rate' = DIVIDE([Override Decisions], [Reviewed Decisions])
		formatString: 0.0%
		lineageTag: 2ae809d4-d5e6-5f1d-af8f-c8c6c4e04bd0

	measure 'Eligible Asset Decisions' = CALCULATE([Decision Count], Decision[category_key] = "waste_litter", Decision[coordinates_supplied] = TRUE())
		formatString: #,0
		lineageTag: 93c25b3d-edf1-5d79-a767-9ed7015621c6

	measure 'Asset Matched Decisions' = CALCULATE([Decision Count], FILTER(Decision, Decision[category_key] = "waste_litter" && Decision[coordinates_supplied] = TRUE() && LEN(Decision[asset_key]) > 0))
		formatString: #,0
		lineageTag: b282aaac-7602-57b5-8523-82cd3f2b54a6

	measure 'Asset Match Rate' = DIVIDE([Asset Matched Decisions], [Eligible Asset Decisions])
		formatString: 0.0%
		lineageTag: 0464ee38-8cb8-555a-8374-ab5def922734

