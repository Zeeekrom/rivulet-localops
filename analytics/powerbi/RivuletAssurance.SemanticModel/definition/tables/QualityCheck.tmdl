table QualityCheck
	lineageTag: 8124dd16-2847-5e52-a285-3aeec6460ca4

	measure 'Quality Check Count' = COUNTROWS(QualityCheck)
		formatString: #,0
		lineageTag: c835ac5f-f441-5980-ac01-99bc0c3027de

	measure 'Warning Check Count' = CALCULATE([Quality Check Count], QualityCheck[status] = "warn")
		formatString: #,0
		lineageTag: 98a915d1-27d0-54a9-8d8d-488a7e7e4538

	measure 'Failed Check Count' = COALESCE(CALCULATE([Quality Check Count], QualityCheck[status] = "fail"), 0)
		formatString: #,0
		lineageTag: 48d1f0c6-fa61-5f52-aa30-3b62c9d82a09

	measure 'Blocking Failure Count' = COALESCE(CALCULATE([Quality Check Count], QualityCheck[status] = "fail", QualityCheck[severity] = "critical"), 0)
		formatString: #,0
		lineageTag: ac822739-b098-5991-afc3-428170fb760d

