model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Source","QualityCheck","Decision","GateRule","Review","ManualFallback","Date"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Source
ref table QualityCheck
ref table Decision
ref table GateRule
ref table Review
ref table ManualFallback
ref table Date

ref cultureInfo en-AU
